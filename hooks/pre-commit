#!/bin/sh
set -e

# Solo chequea, no modifica: así no importa qué otros cambios haya sin stagear.
if ! ./gradlew spotlessCheck --quiet; then
  echo "El código no respeta el formato. Corré './gradlew spotlessApply', agregá los cambios y volvé a commitear."
  exit 1
fi

./gradlew checkstyleMain checkstyleTest test
